<ui:FluentWindow x:Class="DlssgSwapper.App.Views.SteamScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Add game from Steam"
        Height="560" Width="880"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowCornerPreference="Round">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="StatusText" Text="Scanning Steam libraries…" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:Button Content="Rescan" Click="OnRescan" Margin="12,0,0,0" Padding="10,3" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="Games" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ui:ListView x:Name="GamesList" SelectionChanged="OnGameSelected"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ui:ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding InstallDir}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ui:ListView.ItemTemplate>
                </ui:ListView>
            </DockPanel>

            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Text="Candidate rendering executables" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ui:ListView x:Name="ExesList" SelectionChanged="OnExeSelected" DisplayMemberPath="Path"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
        </Grid>

        <UniformGrid Grid.Row="2" Rows="1" Columns="2" Width="220" HorizontalAlignment="Right" Margin="0,10,0,0">
            <ui:Button x:Name="OkButton" Content="Add" Click="OnOk" IsEnabled="False" Margin="0,0,6,0" Padding="12,4" Appearance="Primary" IsDefault="True" />
            <ui:Button Content="Cancel" Click="OnCancel" Padding="12,4" IsCancel="True" />
        </UniformGrid>
    </Grid>
</ui:FluentWindow>