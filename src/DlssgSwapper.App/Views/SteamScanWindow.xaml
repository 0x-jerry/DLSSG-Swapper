<Window x:Class="DlssgSwapper.App.Views.SteamScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add game from Steam"
        Height="560" Width="880"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="StatusText" Text="Scanning Steam libraries…" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Content="Rescan" Click="OnRescan" Margin="12,0,0,0" Padding="10,2" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" Text="Games" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ListBox x:Name="GamesList" SelectionChanged="OnGameSelected"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding InstallDir}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Text="Candidate rendering executables" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ListBox x:Name="ExesList" SelectionChanged="OnExeSelected" DisplayMemberPath="Path"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
        </Grid>

        <UniformGrid Grid.Row="2" Rows="1" Columns="2" Width="220" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="Add" Click="OnOk" IsEnabled="False" Margin="0,0,6,0" Padding="12,4" IsDefault="True" />
            <Button Content="Cancel" Click="OnCancel" Padding="12,4" IsCancel="True" />
        </UniformGrid>
    </Grid>
</Window>