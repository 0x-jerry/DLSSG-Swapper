<ContentDialog
    x:Class="DlssgSwapper.App.Views.SteamScanDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add game from Steam"
    PrimaryButtonText="Add game"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="OnAddGame">

    <Grid Width="800" Height="420" RowDefinitions="Auto,*">
        <InfoBar x:Name="ScanStatus" Grid.Row="0" Margin="0,0,0,12"
                 Severity="Informational" IsClosable="False" IsOpen="False" />

        <Grid Grid.Row="1" ColumnDefinitions="*,16,*">
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Games" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        <ProgressRing x:Name="ScanRing" Width="16" Height="16" Margin="8,0,0,0" IsActive="False" />
                    </StackPanel>
                    <Button Click="OnRescan" Style="{StaticResource ToolbarButton}" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Rescan" />
                        </StackPanel>
                    </Button>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0">
                    <ListView x:Name="GamesList" SelectionChanged="OnGameSelected"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent" BorderThickness="0" Padding="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="6,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding InstallDir}" Style="{StaticResource CaptionText}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>

            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="Rendering executable"
                           Style="{StaticResource SectionTitleText}" Margin="0,0,0,8" />
                <Grid Grid.Row="1">
                    <Border Style="{StaticResource CardPanel}" Margin="0">
                        <ListView x:Name="ExesList" SelectionChanged="OnExeSelected"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent" BorderThickness="0" Padding="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="6,4" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayPath}" Margin="2,1"
                                               ToolTipService.ToolTip="{Binding Exe.Path}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <TextBlock x:Name="ExesHint" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               MaxWidth="240" Style="{StaticResource CaptionText}"
                               Text="Select a game to list its executables." />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentDialog>
