<Page x:Class="DlssgSwapper.App.Views.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,18,28,28">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource BrandMarkBrush}">
                    <FontIcon Glyph="&#xE8AB;" FontSize="30" Foreground="{StaticResource BrandOnMarkBrush}" />
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DLSSG Swapper" Style="{StaticResource PageTitleText}" />
                    <TextBlock Style="{StaticResource PageSubtitleText}" Margin="0,2,0,0"
                               Text="{Binding AboutSubtitle}" />
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="This machine" Style="{StaticResource SectionTitleText}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding GpuSummary}" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding GpuRouterSuggestion}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="Links" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
                    <HyperlinkButton Content="dlssg_for_sm86 — upstream mod" HorizontalAlignment="Left"
                                     NavigateUri="https://github.com/sdli1995/dlssg_for_sm86" Margin="0,0,0,6" />
                    <HyperlinkButton Content="microsoft-ui-xaml — UI framework (MIT)" HorizontalAlignment="Left"
                                     NavigateUri="https://github.com/microsoft/microsoft-ui-xaml" Margin="0,0,0,6" />
                    <HyperlinkButton Content=".NET 9 Desktop Runtime" HorizontalAlignment="Left"
                                     NavigateUri="https://dotnet.microsoft.com/download/dotnet/9.0" />
                </StackPanel>
            </Border>

            <InfoBar IsOpen="True" Severity="Warning" IsClosable="False" Title="Use at your own risk"
                     Message="The bundled proxy DLLs use system-DLL proxying and LoadLibrary hooks, so antivirus and SmartScreen may flag them. Do not install into online or anti-cheat-enabled games unless you accept the risk. Only one package proxy may be installed per game." />
        </StackPanel>
    </ScrollViewer>
</Page>
