<Page x:Class="DlssgSwapper.App.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,18,28,28">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleText}" />
            <TextBlock Style="{StaticResource PageSubtitleText}" Margin="0,3,0,18"
                       Text="Preferences for the app. Installing is always explicit and backed up per game." />

            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <FontIcon Glyph="&#xE790;" FontSize="18"
                                  Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Appearance" Style="{StaticResource SectionTitleText}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Theme" Style="{StaticResource FieldLabelText}" Margin="0,0,12,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" MaxWidth="240" HorizontalAlignment="Left" />
                    </Grid>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,12,0,0"
                               Text="System follows the Windows light/dark setting. The choice is remembered on this machine." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <FontIcon Glyph="&#xEA18;" FontSize="18"
                                  Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Installing" Style="{StaticResource SectionTitleText}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox Content="Allow overwriting foreign files by default"
                              IsChecked="{Binding DefaultOverwriteForeign, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                               Text="Foreign files (for example another mod's dxgi.dll) are always backed up before replacement. This only pre-ticks the per-game confirmation." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <FontIcon Glyph="&#xE838;" FontSize="18"
                                  Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Storage" Style="{StaticResource SectionTitleText}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Backups" Style="{StaticResource FieldLabelText}" />
                    <TextBlock Style="{StaticResource MonoText}" Margin="0,4,0,0" Text="{Binding BackupRoot}" />
                    <Button Command="{Binding OpenBackupFolderCommand}"
                            Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE838;" FontSize="14" />
                            <TextBlock Text="Open backups folder" />
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,10,0,0"
                               Text="Original files are stored here once per game. Keep them until you have confirmed the mod works, so Uninstall can restore byte-identical originals." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
