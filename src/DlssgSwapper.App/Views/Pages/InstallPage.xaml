<Page x:Class="DlssgSwapper.App.Views.Pages.InstallPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Install">
    <Page.Resources>
        <Style x:Key="CardDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,14" />
            <Setter Property="Background" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="DiagnosticPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </Page.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0" Command="{Binding BackCommand}" Style="{StaticResource IconButton}"
                       VerticalAlignment="Top" Margin="0,2,10,0"
                       ToolTip="Back (mouse back button, Alt+Left)" AutomationProperties.Name="Back">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowLeft24" />
                </ui:Button.Icon>
            </ui:Button>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Install &amp; swap" Style="{StaticResource PageTitleText}" />
                <TextBlock Style="{StaticResource PageSubtitleText}" Margin="0,3,0,0"
                           Text="Choose the payload and frame generation settings, then write them next to the game executable." />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <!-- Configured view -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelectedProfile}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <ui:PassiveScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <ui:SymbolIcon Symbol="BoxMultiple24" FontSize="18"
                                                   Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Payload" Style="{StaticResource SectionTitleText}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Version"
                                               Style="{StaticResource FieldLabelText}" Margin="0,0,12,10" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Versions}"
                                              DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedVersion}"
                                              Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Entry point"
                                               Style="{StaticResource FieldLabelText}" Margin="0,0,12,0" />
                                    <ComboBox Grid.Row="1" Grid.Column="1"
                                              ItemsSource="{Binding EntryPointOptions}"
                                              SelectedItem="{Binding SelectedEntryPoint}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                               VerticalAlignment="Center" ToolTip="{Binding Note}" />
                                                    <Border Grid.Column="1" Margin="10,0,0,0" Padding="6,1"
                                                            CornerRadius="8" VerticalAlignment="Center"
                                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPresent}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="found" FontSize="11"
                                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,12,0,0"
                                           Text="The entry point is the proxy DLL name (usually version.dll). Only one package proxy may be installed per game." />
                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                           Text="{Binding EntryPointHint}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <ui:SymbolIcon Symbol="Flash24" FontSize="18"
                                                   Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Frame generation" Style="{StaticResource SectionTitleText}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Preset"
                                               Style="{StaticResource FieldLabelText}" Margin="0,0,12,10" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Presets}"
                                              SelectedItem="{Binding SelectedPreset}" Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Router"
                                               Style="{StaticResource FieldLabelText}" Margin="0,0,12,2" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                        <ComboBox ItemsSource="{Binding Routers}" SelectedItem="{Binding SelectedRouter}" />
                                        <TextBlock Text="{Binding GpuRouterSuggestion}" Style="{StaticResource CaptionText}"
                                                   Margin="2,3,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Kernel image"
                                               Style="{StaticResource FieldLabelText}" Margin="0,0,12,10" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding KernelImages}"
                                              SelectedItem="{Binding SelectedKernelImage}" Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Max generated frames"
                                               Style="{StaticResource FieldLabelText}" Margin="0,0,12,10" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding MaxFrames}"
                                              SelectedItem="{Binding SelectedMaxFrames}" Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Logging level"
                                               Style="{StaticResource FieldLabelText}" Margin="0,0,12,0" />
                                    <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding LoggingLevels}"
                                              SelectedItem="{Binding SelectedLoggingLevel}" />

                                    <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                              Content="Approximate sampling (HardwareBilinear = 1)"
                                              IsChecked="{Binding HardwareBilinear}" Margin="0,18,0,0" />
                                    <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                                              Content="Allow overwriting foreign files (they are backed up first)"
                                              IsChecked="{Binding OverwriteForeign}" Margin="0,10,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ui:PassiveScrollViewer>

                <ui:PassiveScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Target24" FontSize="18"
                                                       Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Target" Style="{StaticResource SectionTitleText}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Style="{StaticResource InstallStatePill}" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" DataContext="{Binding SelectedProfile}">
                                        <TextBlock Text="{Binding InstallState}" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding SelectedProfile.Name}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0" Symbol="Folder24" FontSize="14"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedProfile.ExecutablePath}"
                                               Style="{StaticResource CaptionText}" Margin="6,0,6,0"
                                               VerticalAlignment="Center" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SelectedProfile.ExecutablePath}" />
                                    <ui:Button Grid.Column="2" Command="{Binding OpenGameFolderCommand}"
                                               Style="{StaticResource IconButton}" Width="28" Height="28"
                                               ToolTip="Open game folder" AutomationProperties.Name="Open game folder">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>

                                <Border Style="{StaticResource CardDivider}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Installation" Style="{StaticResource SectionTitleText}" />
                                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                                   Text="Installs the selected payload next to the executable. Turn off to uninstall and restore the originals." />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsInstalled, Mode=TwoWay}"
                                                     IsEnabled="{Binding HasSelectedProfile}"
                                                     VerticalAlignment="Center" Margin="12,0,0,0"
                                                     AutomationProperties.Name="Install or uninstall the payload" />
                                </Grid>

                                <Border Style="{StaticResource CardDivider}" />

                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="16" VerticalAlignment="Center">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Verification.Severity}" Value="Success">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Verification.Severity}" Value="Caution">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <TextBlock Text="Verification" Style="{StaticResource SectionTitleText}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ui:Button Command="{Binding RefreshVerificationCommand}" Style="{StaticResource IconButton}"
                                               HorizontalAlignment="Right" ToolTip="Re-check installed files and mod logs"
                                               AutomationProperties.Name="Re-check installation">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="ArrowSync24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>
                                <TextBlock Text="{Binding Verification.Headline}" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Border Style="{StaticResource DiagnosticPanel}" Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{Binding Verification.Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0" Width="4" Height="4" Margin="0,0,8,0"
                                                             VerticalAlignment="Center"
                                                             Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource CaptionText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>

                        <ui:CardExpander Header="Output" IsExpanded="False" Margin="0,0,0,12">
                            <StackPanel>
                                <ui:TextBox Text="{Binding StatusText, Mode=OneWay}" IsReadOnly="True"
                                            TextWrapping="Wrap" AcceptsReturn="True" Height="150"
                                            VerticalScrollBarVisibility="Auto"
                                            FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                <ui:Button Content="Copy" Command="{Binding CopyStatusCommand}"
                                           Style="{StaticResource ToolbarButton}" HorizontalAlignment="Right" Margin="0,8,0,0" />
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </ui:PassiveScrollViewer>
            </Grid>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelectedProfile}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="72" Height="72" CornerRadius="18" HorizontalAlignment="Center"
                        Background="{StaticResource BrandSoftBrush}">
                    <ui:SymbolIcon Symbol="Wrench24" FontSize="32" Foreground="{StaticResource BrandBrush}" />
                </Border>
                <TextBlock Text="No game selected" Style="{StaticResource SectionTitleText}"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Style="{StaticResource CaptionText}" TextAlignment="Center" Margin="0,6,0,18"
                           Text="Pick a game in the Library first, then choose the payload and install the proxy." />
                <ui:Button Content="Go to Library" Command="{Binding ShowGamesCommand}"
                           Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
