<Page x:Class="DlssgSwapper.App.Views.Pages.InstallPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Install">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Install &amp; swap" Style="{StaticResource PageTitleText}" />
            <TextBlock Style="{StaticResource PageSubtitleText}" Margin="0,3,0,0"
                       Text="Choose the payload and frame generation settings, then write them next to the game executable." />
        </StackPanel>

        <Grid Grid.Row="1">
            <!-- Configured view -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelectedProfile}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <ui:SymbolIcon Symbol="BoxMultiple24" FontSize="18"
                                                   Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Payload" Style="{StaticResource SectionTitleText}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Version"
                                               Style="{StaticResource FieldLabelText}" Margin="0,0,12,10" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Versions}"
                                              DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedVersion}"
                                              Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Entry point"
                                               Style="{StaticResource FieldLabelText}" Margin="0,0,12,0" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SelectedVersion.EntryPoints}"
                                              DisplayMemberPath="FileName" SelectedItem="{Binding SelectedEntryPoint}" />
                                </Grid>
                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,12,0,0"
                                           Text="The entry point is the proxy DLL name (usually version.dll). Only one package proxy may be installed per game." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <ui:SymbolIcon Symbol="Flash24" FontSize="18"
                                                   Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Frame generation" Style="{StaticResource SectionTitleText}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Preset"
                                               Style="{StaticResource FieldLabelText}" Margin="0,0,12,10" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Presets}"
                                              SelectedItem="{Binding SelectedPreset}" Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Router"
                                               Style="{StaticResource FieldLabelText}" Margin="0,0,12,2" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                        <ComboBox ItemsSource="{Binding Routers}" SelectedItem="{Binding SelectedRouter}" />
                                        <TextBlock Text="{Binding GpuRouterSuggestion}" Style="{StaticResource CaptionText}"
                                                   Margin="2,3,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Kernel image"
                                               Style="{StaticResource FieldLabelText}" Margin="0,0,12,10" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding KernelImages}"
                                              SelectedItem="{Binding SelectedKernelImage}" Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Max generated frames"
                                               Style="{StaticResource FieldLabelText}" Margin="0,0,12,10" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding MaxFrames}"
                                              SelectedItem="{Binding SelectedMaxFrames}" Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Logging level"
                                               Style="{StaticResource FieldLabelText}" Margin="0,0,12,0" />
                                    <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding LoggingLevels}"
                                              SelectedItem="{Binding SelectedLoggingLevel}" />

                                    <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                              Content="Approximate sampling (HardwareBilinear = 1)"
                                              IsChecked="{Binding HardwareBilinear}" Margin="0,18,0,0" />
                                    <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                                              Content="Allow overwriting foreign files (they are backed up first)"
                                              IsChecked="{Binding OverwriteForeign}" Margin="0,10,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ui:InfoBar IsOpen="{Binding IsStatusVisible}" Severity="{Binding StatusSeverity}"
                                    Message="{Binding StatusHeadline}" IsClosable="False" Margin="0,0,0,12" />

                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Target" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
                                <TextBlock Text="{Binding SelectedProfile.Name}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SelectedProfile.ExecutablePath}" Style="{StaticResource CaptionText}"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                <Border Style="{StaticResource InstallStatePill}" HorizontalAlignment="Left" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding SelectedProfile.InstallState}" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Border>
                                <ui:Button Content="Open folder" Command="{Binding OpenGameFolderCommand}"
                                           Style="{StaticResource ToolbarButton}" HorizontalAlignment="Left" Margin="0,12,0,0">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="FolderOpen24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <ui:Button Content="Install / Swap" Command="{Binding InstallCommand}"
                                           Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="ArrowSwap24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Content="Verify" Command="{Binding VerifyCommand}"
                                           Style="{StaticResource ToolbarButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="CheckmarkCircle24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Content="Uninstall" Command="{Binding UninstallCommand}"
                                           Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Delete24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Border>

                        <ui:CardExpander Header="Output" IsExpanded="False" Margin="0,0,0,12">
                            <StackPanel>
                                <ui:TextBox Text="{Binding StatusText, Mode=OneWay}" IsReadOnly="True"
                                            TextWrapping="Wrap" AcceptsReturn="True" Height="150"
                                            VerticalScrollBarVisibility="Auto"
                                            FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                <ui:Button Content="Copy" Command="{Binding CopyStatusCommand}"
                                           Style="{StaticResource ToolbarButton}" HorizontalAlignment="Right" Margin="0,8,0,0" />
                            </StackPanel>
                        </ui:CardExpander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelectedProfile}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="72" Height="72" CornerRadius="18" HorizontalAlignment="Center"
                        Background="{StaticResource BrandSoftBrush}">
                    <ui:SymbolIcon Symbol="Wrench24" FontSize="32" Foreground="{StaticResource BrandBrush}" />
                </Border>
                <TextBlock Text="No game selected" Style="{StaticResource SectionTitleText}"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Style="{StaticResource CaptionText}" TextAlignment="Center" Margin="0,6,0,18"
                           Text="Pick a game in the Library first, then choose the payload and install the proxy." />
                <ui:Button Content="Go to Library" Command="{Binding ShowGamesCommand}"
                           Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
