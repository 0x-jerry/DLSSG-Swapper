<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Layout scale -->
    <Thickness x:Key="PagePadding">28,18,28,28</Thickness>
    <Thickness x:Key="CardPadding">18,16</Thickness>
    <Thickness x:Key="CardMargin">0,0,0,12</Thickness>

    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">20</CornerRadius>
    <CornerRadius x:Key="MarkCornerRadius">9</CornerRadius>

    <!-- Brand. Theme-independent on purpose: these read on both Mica and solid dark surfaces. -->
    <SolidColorBrush x:Key="BrandBrush" Color="#FF76B900" />
    <SolidColorBrush x:Key="BrandSoftBrush" Color="#2E76B900" />
    <SolidColorBrush x:Key="BrandOnMarkBrush" Color="#FF14210A" />
    <LinearGradientBrush x:Key="BrandMarkBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF9AE600" Offset="0" />
        <GradientStop Color="#FF5E9600" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
